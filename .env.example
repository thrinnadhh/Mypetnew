# MyPetNew local development template.
# This profile intentionally keeps domain state/payment providers in memory/fake.
SPRING_PROFILES_ACTIVE=development

# The application still initializes the datasource/Flyway in development, so use
# an isolated development database. Never point local development at production.
DATABASE_URL=jdbc:postgresql://db.example.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=mypet_runtime
DATABASE_PASSWORD=replace-in-secret-manager
MYPET_TOKEN_SECRET=replace-with-at-least-32-random-characters
MYPET_TOKEN_ISSUER=mypetnew-api
MYPET_TOKEN_AUDIENCE=mypetnew-role-apps
MYPET_DEVICE_TOKEN_KEY=replace-with-base64-encoded-32-byte-key
MYPET_ENVIRONMENT=development

# Supabase values may still be supplied for local infrastructure checks, but the
# development domain adapters remain isolated from staging persistence.
SUPABASE_URL=https://replace.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-server-secret-manager
SUPABASE_PRIVATE_EVIDENCE_BUCKET=provider-verification-private
SUPABASE_CATALOG_MEDIA_BUCKET=catalog-media

# Firebase delivery and the real Cashfree adapter are disabled by the development profile.
FIREBASE_PROJECT_ID=mypetnew-development
CASHFREE_ENABLED=false
CASHFREE_API_VERSION=2025-01-01
CASHFREE_WEBHOOK_VERSION=2025-01-01
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg

# Local Customer app defaults. Android physical devices must use the Mac LAN IP
# instead of localhost; production/release builds must use HTTPS.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# For persistent end-to-end testing with real Cashfree sandbox, use
# .env.staging.example instead of enabling Cashfree in this development profile.
