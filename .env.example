# Backend (server only)
DATABASE_URL=jdbc:postgresql://db.example.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=mypet_runtime
DATABASE_PASSWORD=replace-in-secret-manager
MYPET_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Role apps (public build configuration only)
APP_ENV=development
EXPO_PUBLIC_API_URL=http://127.0.0.1:8080
EXPO_PUBLIC_FIREBASE_PROJECT_ID=mypetnew-development
EXPO_PUBLIC_FIREBASE_APP_ID=replace-with-public-firebase-app-id

# Admin browser (public URL only)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080

