# MyPetNew staging runtime template.
# Copy to an ignored local/deployment secret file; never commit real values.
SPRING_PROFILES_ACTIVE=staging

# Persistent backend infrastructure.
DATABASE_URL=jdbc:postgresql://db.example.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=mypet_runtime
DATABASE_PASSWORD=replace-in-secret-manager
MYPET_TOKEN_SECRET=replace-with-at-least-32-random-characters
MYPET_TOKEN_ISSUER=mypetnew-api
MYPET_TOKEN_AUDIENCE=mypetnew-role-apps
MYPET_DEVICE_TOKEN_KEY=replace-with-base64-encoded-32-byte-key
MYPET_ENVIRONMENT=staging

# Supabase server-side configuration.
SUPABASE_URL=https://replace.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-server-secret-manager
SUPABASE_PRIVATE_EVIDENCE_BUCKET=provider-verification-private

# Firebase/FCM is active outside development and requires real staging credentials.
FIREBASE_PROJECT_ID=mypetnew-staging
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json

# Cashfree staging certification is always the real sandbox adapter, never FakePaymentGateway.
CASHFREE_ENABLED=true
CASHFREE_CLIENT_ID=replace-with-sandbox-client-id
CASHFREE_CLIENT_SECRET=replace-in-server-secret-manager
CASHFREE_API_VERSION=2025-01-01
CASHFREE_WEBHOOK_VERSION=2025-01-01
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_RETURN_URL=https://staging.example.com/payments/cashfree/return
CASHFREE_NOTIFY_URL=https://api-staging.example.com/api/v1/webhooks/cashfree/payments

# Customer staging build. Use the same public HTTPS API origin as Cashfree webhooks.
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_API_BASE_URL=https://api-staging.example.com
