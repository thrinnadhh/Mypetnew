# MyPetNew staging runtime template.
# Copy to an ignored local/deployment secret file; never commit real values.
SPRING_PROFILES_ACTIVE=staging

# Persistent backend infrastructure.
DATABASE_URL=jdbc:postgresql://db.example.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=mypet_runtime
DATABASE_PASSWORD=replace-in-secret-manager

# Flyway uses a privileged migration identity separate from the DML-only
# application runtime identity.
SPRING_FLYWAY_URL=jdbc:postgresql://db.example.supabase.co:5432/postgres?sslmode=require
SPRING_FLYWAY_USER=replace-with-migration-user
SPRING_FLYWAY_PASSWORD=replace-in-secret-manager
MYPET_TOKEN_SECRET=replace-with-at-least-32-random-characters
MYPET_TOKEN_ISSUER=mypetnew-api
MYPET_TOKEN_AUDIENCE=mypetnew-role-apps
MYPET_DEVICE_TOKEN_KEY=replace-with-base64-encoded-32-byte-key
MYPET_ENVIRONMENT=staging

# Explicit browser origins only; never use a wildcard. Native mobile clients do
# not require CORS, but Expo web and browser certification do.
MYPET_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Supabase server-side configuration. Keep provider evidence private; catalog
# media uses a separate bucket intended for customer-visible product images.
SUPABASE_URL=https://replace.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-server-secret-manager
SUPABASE_PRIVATE_EVIDENCE_BUCKET=provider-verification-private
SUPABASE_CATALOG_MEDIA_BUCKET=catalog-media

# P2 default: persist notification history/device registrations, but do not start
# the Firebase sender/worker until Firebase staging credentials are configured.
FIREBASE_PROJECT_ID=mypetnew-staging
NOTIFICATION_DELIVERY_ENABLED=false
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-staging-service-account.json

# P2 default: the persistent Cashfree adapter is present but unavailable. P9 flips
# this to true only after sandbox credentials and public HTTPS callback URLs exist.
CASHFREE_ENABLED=false
CASHFREE_API_VERSION=2025-01-01
CASHFREE_WEBHOOK_VERSION=2025-01-01
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
# CASHFREE_CLIENT_ID=replace-with-sandbox-client-id
# CASHFREE_CLIENT_SECRET=replace-in-server-secret-manager
# CASHFREE_RETURN_URL=https://staging.example.com/payments/cashfree/return
# CASHFREE_NOTIFY_URL=https://api-staging.example.com/api/v1/webhooks/cashfree/payments

# Customer staging build. Replace with the public HTTPS backend origin when P8
# deploys staging; local P2 backend certification does not require this value.
EXPO_PUBLIC_APP_ENV=staging
EXPO_PUBLIC_API_BASE_URL=https://api-staging.example.com
