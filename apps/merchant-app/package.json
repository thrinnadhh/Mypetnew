{
  "name": "merchant-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:routes": "node ../../scripts/merchant-app/verify-route-hygiene.mjs",
    "lint": "expo lint --quiet",
    "test": "jest --runInBand",
    "test:ci": "jest --ci --runInBand --coverage",
    "test:contract": "jest --ci --runInBand --testPathPattern=src",
    "test:offline": "jest --ci --runInBand --testPathPattern=offline-harness"
  },
  "dependencies": {
    "expo": "~56.0.19",
    "expo-constants": "~56.0.23",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-image-picker": "~56.0.23",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.18",
    "expo-secure-store": "~56.0.4",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.2",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "brace-expansion": "^1.1.17",
    "uuid": "^11.1.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    }
  }
}
