{
  "schema_version": 1,
  "default": "deny",
  "roles": {
    "advisor": ["repository.read", "git.history.read", "reports.read"],
    "orchestrator": ["repository.read", "git.diff.read", "analyzers.run", "checks.run", "reports.write", "workers.coordinate"],
    "backend": ["repository.backend.read", "repository.backend.write", "checks.backend.run"],
    "database": ["repository.migrations.read", "repository.migrations.write", "database.test.run"],
    "customer-app": ["repository.customer.read", "repository.customer.write", "checks.customer.run"],
    "merchant-app": ["repository.merchant.read", "repository.merchant.write", "checks.merchant.run"],
    "captain-app": ["repository.captain.read", "repository.captain.write", "checks.captain.run"],
    "device": ["repository.apps.read", "device.test.run"],
    "release": ["repository.read", "ci.read", "pull_request.draft.write"]
  },
  "never_default": ["database.production.write", "secrets.read", "pull_request.merge", "deployment.production.run"]
}
