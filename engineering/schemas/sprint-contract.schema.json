{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mypetnew.invalid/schemas/sprint-contract.schema.json",
  "title": "MyPetNew sprint contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sprint", "scope", "workers", "acceptance", "certification"],
  "properties": {
    "schema_version": { "const": 1 },
    "sprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objective", "starting_sha"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "objective": { "$ref": "#/$defs/nonEmptyString" },
        "starting_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_paths", "forbidden_paths", "justifications"],
      "properties": {
        "allowed_paths": { "$ref": "#/$defs/nonEmptyStringArray" },
        "forbidden_paths": { "$ref": "#/$defs/stringArray" },
        "justifications": { "type": "object", "additionalProperties": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "objective", "allowed_paths", "forbidden_paths", "repository_facts", "dependencies", "acceptance_criteria", "required_check_ids", "expected_artifacts", "evidence_requirements"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "role": { "$ref": "#/$defs/nonEmptyString" },
          "objective": { "$ref": "#/$defs/nonEmptyString" },
          "allowed_paths": { "$ref": "#/$defs/nonEmptyStringArray" },
          "forbidden_paths": { "$ref": "#/$defs/stringArray" },
          "repository_facts": { "$ref": "#/$defs/nonEmptyStringArray" },
          "dependencies": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "acceptance_criteria": { "$ref": "#/$defs/nonEmptyStringArray" },
          "required_check_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
          "expected_artifacts": { "$ref": "#/$defs/nonEmptyStringArray" },
          "evidence_requirements": { "$ref": "#/$defs/nonEmptyStringArray" }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["functional", "regression", "security", "contracts"],
      "properties": {
        "functional": { "$ref": "#/$defs/nonEmptyStringArray" },
        "regression": { "$ref": "#/$defs/nonEmptyStringArray" },
        "security": { "$ref": "#/$defs/nonEmptyStringArray" },
        "contracts": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_checks", "merge_policy"],
      "properties": {
        "required_checks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "merge_policy": { "enum": ["all_required_pass", "all_required_pass_no_warnings"] }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringArray": { "type": "array", "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true },
    "nonEmptyStringArray": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true }
  }
}
