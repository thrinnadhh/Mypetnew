{
  "name": "mypetnew",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "22.23.2",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "build": "corepack pnpm -r --if-present build",
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "lint": "eslint apps packages --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "secret-scan": "./scripts/secret-scan.sh",
    "dependency-audit": "./scripts/dependency-audit.sh",
    "verify": "./scripts/verify.sh"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "4.1.10"
  }
}
